;; Small deterministic fixture for promise completion and callback rollback.
;; start(destination, endpoint, remoteGas, callbackMode): 0=ok, 1=error, 2=out-of-gas.
(module
 (import "env" "getArgument" (func $arg (param i32 i32) (result i32)))
 (import "env" "smallIntGetUnsignedArgument" (func $intarg (param i32) (result i64)))
 (import "env" "getCallValue" (func $value (param i32) (result i32)))
 (import "env" "transferValue" (func $transfer (param i32 i32 i32 i32) (result i32)))
 (import "env" "createAsyncCall" (func $promise (param i32 i32 i32 i32 i32 i32 i32 i32 i64 i64) (result i32)))
 (import "env" "storageLoad" (func $load (param i32 i32 i32) (result i32)))
 (import "env" "storageStore" (func $store (param i32 i32 i32 i32) (result i32)))
 (import "env" "signalError" (func $error (param i32 i32)))
 (import "env" "finish" (func $finish (param i32 i32)))
 (memory (export "memory") 1)
 (data (i32.const 256) "callback_ok")
 (data (i32.const 272) "callback_fail")
 (data (i32.const 288) "callback_oog")
 (data (i32.const 320) "smoke callback failure")
 (data (i32.const 400) "count")
 (data (i32.const 448) "smoke transfer rejected")
 (func (export "init"))
 ;; Forward the incoming EGLD as a pure transfer (no destination endpoint).
 (func (export "send")
  (drop (call $arg (i32.const 0) (i32.const 0)))
  (drop (call $value (i32.const 64)))
  (if (call $transfer (i32.const 0) (i32.const 64) (i32.const 128) (i32.const 0))
   (then (call $error (i32.const 448) (i32.const 23)))))
 (func (export "start") (local $size i32) (local $callback i32) (local $length i32)
  (drop (call $arg (i32.const 0) (i32.const 0)))
  (local.set $size (call $arg (i32.const 1) (i32.const 128)))
  (drop (call $value (i32.const 64)))
  (local.set $callback (i32.const 256)) (local.set $length (i32.const 11))
  (if (i64.eq (call $intarg (i32.const 3)) (i64.const 1)) (then
   (local.set $callback (i32.const 272)) (local.set $length (i32.const 13))))
  (if (i64.eq (call $intarg (i32.const 3)) (i64.const 2)) (then
   (local.set $callback (i32.const 288)) (local.set $length (i32.const 12))))
  (if (call $promise (i32.const 0) (i32.const 64) (i32.const 128) (local.get $size)
    (local.get $callback) (local.get $length) (i32.const 256) (i32.const 11)
    (call $intarg (i32.const 2)) (i64.const 1000000))
   (then (call $error (i32.const 320) (i32.const 22)))))
 (func $increment
  (drop (call $load (i32.const 400) (i32.const 5) (i32.const 512)))
  (i32.store8 (i32.const 512) (i32.add (i32.load8_u (i32.const 512)) (i32.const 1)))
  (drop (call $store (i32.const 400) (i32.const 5) (i32.const 512) (i32.const 1))))
 (func (export "callback_ok") (call $increment))
 (func (export "callback_fail")
  (call $increment)
  (call $error (i32.const 320) (i32.const 22)))
 (func (export "callback_oog") (local $i i32)
  (call $increment)
  ;; Deliberately exceeds the callback's metered gas, with a finite upper bound.
  (loop $burn
   (local.set $i (i32.add (local.get $i) (i32.const 1)))
   (br_if $burn (i32.lt_u (local.get $i) (i32.const 10000000)))))
 (func (export "getCallbackCount") (local $length i32)
  (local.set $length (call $load (i32.const 400) (i32.const 5) (i32.const 512)))
  (call $finish (i32.const 512) (local.get $length)))
)
